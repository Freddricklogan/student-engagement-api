# Copy to .env and fill in. NEVER commit a real .env.
# Every value here is read by app/infrastructure/settings.py via pydantic-settings.

# --- Application ---------------------------------------------------------
APP_NAME="Student Engagement Analytics API"
ENVIRONMENT=local                 # local | ci | staging | production
DEBUG=false

# --- Demo mode -----------------------------------------------------------
# true  -> creates the schema, the three demo accounts and a deterministic
#          dataset at startup, and generates an ephemeral JWT_SECRET_KEY.
# false -> JWT_SECRET_KEY below becomes mandatory and startup fails without it.
DEMO_MODE=true
DEMO_SEED=42
DEMO_VIEWER_USERNAME=demo
DEMO_VIEWER_PASSWORD=demo-viewer-2026
DEMO_ANALYST_USERNAME=analyst
DEMO_ANALYST_PASSWORD=analyst-demo-2026
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=admin-demo-2026

# --- Database ------------------------------------------------------------
# SQLite (default, zero-config):
DATABASE_URL=sqlite+aiosqlite:///./engagement.db
# Postgres (no code change required):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/engagement
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# --- Security ------------------------------------------------------------
# Required when DEMO_MODE=false. At least 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ISSUER=student-engagement-api
JWT_AUDIENCE=student-engagement-clients
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- CORS ----------------------------------------------------------------
# Comma-separated or a JSON list. Closed by default; never use "*".
CORS_ALLOW_ORIGINS=http://localhost:8000
CORS_ALLOW_CREDENTIALS=false
CORS_ALLOW_METHODS=GET,POST,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type,X-Request-ID

# --- Rate limiting -------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_AUTH=10/minute

# --- Logging -------------------------------------------------------------
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                   # json | console
